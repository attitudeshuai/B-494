<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.lostandfound.mapper.UserMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (name, student_id, email, phone, password, avatar, address, status)
        VALUES (#{name}, #{studentId}, #{email}, #{phone}, #{password}, #{avatar}, #{address}, #{status})
    </insert>

    <select id="selectById" resultType="com.school.lostandfound.entity.User">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="selectByStudentId" resultType="com.school.lostandfound.entity.User">
        SELECT * FROM users WHERE student_id = #{studentId}
    </select>

    <select id="selectByEmail" resultType="com.school.lostandfound.entity.User">
        SELECT * FROM users WHERE email = #{email}
    </select>
    
    <select id="selectByPhone" resultType="com.school.lostandfound.entity.User">
        SELECT * FROM users WHERE phone = #{phone}
    </select>

    <update id="update">
        UPDATE users
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="password != null">password = #{password},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="address != null">address = #{address},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectAll" resultType="com.school.lostandfound.entity.User">
        SELECT * FROM users
    </select>
    
    <delete id="deleteById">
        DELETE FROM users WHERE id = #{id}
    </delete>
</mapper>
