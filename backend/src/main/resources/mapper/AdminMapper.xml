<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.lostandfound.mapper.AdminMapper">
    <select id="selectByAccount" resultType="com.school.lostandfound.entity.Admin">
        SELECT * FROM admins WHERE account = #{account}
    </select>

    <select id="selectById" resultType="com.school.lostandfound.entity.Admin">
        SELECT * FROM admins WHERE id = #{id}
    </select>
</mapper>
